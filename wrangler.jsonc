{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "file-host",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-12",
	"workers_dev": false,
	"preview_urls": false,
	// UPLOAD_TOKEN gates every PUT. Set it locally in .dev.vars and in production
	// with: npx wrangler secret put UPLOAD_TOKEN
	"secrets": {
		"required": ["UPLOAD_TOKEN"],
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"routes": [
		{
			"pattern": "file-host.vieira.tools",
			"custom_domain": true,
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "file-host",
		},
	],
	"ratelimits": [
		{
			"name": "UPLOAD_RATE_LIMITER",
			"namespace_id": "274981531",
			"simple": {
				"limit": 60,
				"period": 60,
			},
		},
	],
}
